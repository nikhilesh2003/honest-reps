# Optional Production Integrations (App works fully out-of-the-box locally with file persistence)

# Supabase (Google OAuth + Postgres with RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider (Server-side only - never exposed to client, NFR-1)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Web Push (VAPID keys for PWA notifications, FR-40)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
